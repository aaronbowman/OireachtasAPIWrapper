oireachtas.ie\\/ie\\/oireachtas\\/act\\/2025\\/4\\/eng\\/enacted"}},{"version":{"date":"2025-04-02","docType":"bill","formats":{"pdf":{"uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/65\\/eng\\/ver_a\\/b65a24d.pdf"},"xml":null},"lang":"eng","showAs":"As passed by D\\u00e1il \\u00c9ireann","uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/65\\/eng\\/ver_a"}},{"version":{"date":"2024-07-31","docType":"bill","formats":{"pdf":{"uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/65\\/eng\\/initiated\\/b6524d.pdf"},"xml":null},"lang":"eng","showAs":"As Initiated","uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/65\\/eng\\/initiated"}}]},"billSort":{"actNoSort":4,"actShortTitleEnSort":"finance-provision-of-access-to-cash-infrastructure-act-2025","actShortTitleGaSort":"an-tacht-airgeadais-rochtain-ar-bhonneagar-airgid-thirim-a-sholathar-2025","actYearSort":2025,"billNoSort":65,"billShortTitleEnSort":"finance-provision-of-access-to-cash-infrastructure-bill-2024","billShortTitleGaSort":"an-bille-airgeadais-rochtain-ar-bhonneagar-airgid-thirim-a-sholathar-2024","billYearSort":2024},"contextDate":"2025-05-20"},{"bill":{"act":{"actNo":"2","actYear":"2025","dateSigned":"2025-04-14","longTitleEn":"<p>Act to provide for the dissolution of the Marine Casualty Investigation Board and for its replacement with a unit within the Department of Transport to be known as the Marine Accident Investigation Unit; to provide for the investigation and reporting of marine accidents; to repeal the Merchant Shipping (Investigation of Marine Casualties) Act 2000; to provide for the regulation of offshore service vessels; for those and other purposes to amend the Merchant Shipping (Safety Convention) Act 1952, the Merchant Shipping Act 1992 and the Merchant Shipping Act 2010; and to provide for related matters.<\\/p>","longTitleGa":"<p>Acht do dh\\u00e9anamh socr\\u00fa chun an Bord um Thaism\\u00ed Muir\\u00ed a Imscr\\u00fad\\u00fa a dh\\u00edscaoileadh agus chun aonad laistigh den Roinn Iompair ar a dtabharfar an tAonad um Imscr\\u00fad\\u00fa Tion\\u00f3isc\\u00ed Muir\\u00ed a chur ina ionad; do dh\\u00e9anamh socr\\u00fa maidir le tion\\u00f3isc\\u00ed muir\\u00ed a imscr\\u00fad\\u00fa agus a thuairisci\\u00fa; d\\u2019aisghairm an Achta Loingis Cheanna\\u00edochta (Taism\\u00ed Muir\\u00ed a Imscr\\u00fad\\u00fa), 2000; do dh\\u00e9anamh socr\\u00fa maidir le rial\\u00e1il a dh\\u00e9anamh ar \\u00e1rtha\\u00ed seirbh\\u00edse amach \\u00f3n gc\\u00f3sta; chun na gcr\\u00edoch sin agus chun cr\\u00edoch eile, do leas\\u00fa an Achta Loingis Cheanna\\u00edochta (Coinbhinsi\\u00fan S\\u00e1bh\\u00e1ltachta), 1952, an Achta Loingis Cheanna\\u00edochta, 1992 agus an Achta Loingis Cheanna\\u00edochta, 2010; agus do dh\\u00e9anamh socr\\u00fa i dtaobh nithe gaolmhara.<\\/p>","shortTitleEn":"Merchant Shipping (Investigation of Marine Accidents) Act 2025","shortTitleGa":"An tAcht Loingis Cheanna\\u00edochta (Tion\\u00f3isc\\u00ed Muir\\u00ed a Imscr\\u00fad\\u00fa), 2025","statutebookURI":"http:\\/\\/www.irishstatutebook.ie\\/eli\\/2025\\/act\\/2","uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/act\\/2025\\/2"},"amendmentLists":[{"amendmentList":{"amendmentTypeUri":{"uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/def\\/amendment-type\\/numberedList"},"chamber":{"showAs":"Seanad","uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/def\\/seanad"},"date":"2025-04-08","formats":{"pdf":{"uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/64\\/seanad\\/4\\/amendment\\/numberedList\\/eng\\/b64b24s-nl.pdf"},"xml":null},"showAs":"Numbered List [Seanad]","stage":{"showAs":"Report Stage","uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/bill\\/2024\\/64\\/seanad\\/4"},"stageNo":"4"}},{"amendmentList":{"amendmentTypeUri":{"uri":"https:\\/\\/data.oireachtas.ie\\/ie\\/oireachtas\\/def\\/amendment-type\\/numberedList"},"chamber":{"show